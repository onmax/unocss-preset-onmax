{
  "type": "module",
  "version": "1.0.0-beta.50",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "nr -r build",
    "dev": "nr -r dev",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache . --fix",
    "prepublishOnly": "nr build",
    "docs": "pnpm -C docs run docs:dev",
    "docs:build": "nr build && pnpm -C docs run build",
    "release": "bumpp -r && pnpm -r publish",
    "test": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "unocss": "catalog:style"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@antfu/ni": "catalog:dev",
    "@antfu/utils": "catalog:dev",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "eslint": "catalog:lint",
    "eslint-plugin-format": "catalog:lint",
    "eslint-plugin-pnpm-catalogs": "catalog:lint",
    "lint-staged": "catalog:lint",
    "pncat": "catalog:cli",
    "pnpm": "catalog:dev",
    "simple-git-hooks": "catalog:lint",
    "tsx": "catalog:script",
    "typescript": "catalog:dev",
    "unbuild": "catalog:build",
    "unocss-preset-css-var": "workspace:*",
    "unocss-preset-scale-px": "workspace:*",
    "unocss-preset-unovue": "workspace:*",
    "vite": "catalog:build",
    "vitest": "catalog:test",
    "vue-tsc": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
